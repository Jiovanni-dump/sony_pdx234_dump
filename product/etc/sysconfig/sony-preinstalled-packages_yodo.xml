<?xml version="1.0" encoding="utf-8"?>
<!-- System packages to preinstall on Sony Xperia devices based on Android V, per user type.
     Documentation at frameworks/base/data/etc/preinstalled-packages-platform.xml
-->
<config>
    <!--  Music -->
    <install-in-user-type package="com.sonyericsson.music">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
        <do-not-install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  FM Radio App -->
    <install-in-user-type package="com.sonymobile.fmradio">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
        <do-not-install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Google Assistant -->
    <install-in-user-type package="com.google.android.apps.googleassistant">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
        <do-not-install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Orange update -->
    <install-in-user-type package="com.orange.update">
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
        <do-not-install-in user-type="android.os.usertype.profile.CLONE" />
        <do-not-install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>
</config>
